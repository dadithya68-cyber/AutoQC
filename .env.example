# =======================================================
# APEX MOTORS QUALITY ASSURANCE & DEFECT TELEMETRY CONFIG
# =======================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=*

# PostgreSQL Database Configuration
# Standard local URL: postgresql://postgres:postgres@localhost:5432/automotive_qa
# Docker Compose URL: postgresql://postgres:postgrespassword@postgres:5432/automotive_qa
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/automotive_qa
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=automotive_qa

# Redis Cache & Pub/Sub Configuration
# Standard local URL: redis://localhost:6379
# Docker Compose URL: redis://redis:6379
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# Fallback Configuration:
# The system features automatic zero-configuration fallback.
# If PostgreSQL or Redis are not reachable during local dev,
# the server automatically activates the embedded high-performance
# in-memory automotive engine with full seed telemetry data.
